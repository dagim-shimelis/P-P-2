# Public project token from PostHog project settings (not a personal API key).
NUXT_PUBLIC_POSTHOG_KEY=
# Use the PostHog ingestion host for your project (for example, https://eu.i.posthog.com).
NUXT_PUBLIC_POSTHOG_HOST=

# Build-time credentials for PostHog source-map uploads.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=your_posthog_project_id
POSTHOG_CLI_HOST=https://your-posthog-app-host.example
