FRAGMENT_SHADER,'precision mediump float;varying vec3 c;uniform bool points;void main(){if(points&&distance(gl_PointCoord,vec2(.5))>.5)discard;gl_FragColor=vec4(c,1.);}'));gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(program));gl.useProgram(program);apos=gl.getAttribLocation(program,'position');acol=gl.getAttribLocation(program,'color');uyaw=gl.getUniformLocation(program,'yaw');upitch=gl.getUniformLocation(program,'pitch');uscale=gl.getUniformLocation(program,'scale');ucenter=gl.getUniformLocation(program,'center');upoints=gl.getUniformLocation(program,'points');surface=gl.createBuffer();linebuffer=gl.createBuffer();pointbuffer=gl.createBuffer();gl.enable(gl.DEPTH_TEST);}else document.querySelector('#error').style.display='block';\nfunction cross(a,b){return[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]]}function sub(a,b){return a.map((v,i)=>v-b[i])}function norm(v){let l=Math.hypot(...v);return v.map(x=>x/l)}\nfunction currentPieces(){return MODELS[shape].pieces.filter(p=>document.querySelector('#part').value==='all'||p.part===document.querySelector('#part').value)}\nfunction rebuild(){if(!gl)return;let tris=[],lines=[],dots=[],e=+document.querySelector('#explode').value/100;let pieces=currentPieces();for(const p of pieces){const center=p.vertices.reduce((a,v)=>a.map((x,i)=>x+v[i]/p.vertices.length),[0,0,0]);let shift=center.map((v,i)=>(v-[.8,0,3.15][i])*e*.5);const vs=p.vertices.map(v=>v.map((x,i)=>x+shift[i]));let base=p.color.match(/\\w\\w/g).map(x=>parseInt(x,16)/255),light=norm([-.4,-.6,1]);for(const f of p.faces){let n=norm(cross(sub(vs[f[1]],vs[f[0]]),sub(vs[f[2]],vs[f[0]]))),shade=.67+.3*Math.max(0,n.reduce((a,v,i)=>a+v*light[i],0)),color=base.map(v=>v*shade);for(let j=1;j<f.length-1;j++)for(const k of[f[0],f[j],f[j+1]])tris.push(...vs[k],...color)}let edges=new Set();for(const f of p.faces)for(let i=0;i<f.length;i++){let a=f[i],b=f[(i+1)%f.length];let key=[Math.min(a,b),Math.max(a,b)].join(',');if(!edges.has(key)){edges.add(key);lines.push(...vs[a],.36,.32,.25,...vs[b],.36,.32,.25)}}}\n// Ink eyes sit on the head surface; they are not extra solids.\nif((document.querySelector('#part').value==='all'||document.querySelector('#part').value==='Head')&&e===0){let s=.6733333333,z=.25,r=1.05*s;let y=(shape==='3'?(1-z)/2:shape==='4'?1:1-.35*Math.abs(z))*r;for(let sign of[-1,1])dots.push(3.35*1.05,sign*(y*1.05+.006),(3.9+r*(1+z))*1.05,.12,.12,.10)}\nfor(const [b,data] of[[surface,tris],[linebuffer,lines],[pointbuffer,dots]]){gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(data),gl.STATIC_DRAW)}triCount=tris.length/6;lineCount=lines.length/6;pointCount=dots.length/6;draw()}\nfunction bind(b){gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.enableVertexAttribArray(apos);gl.vertexAttribPointer(apos,3,gl.FLOAT,false,24,0);gl.enableVertexAttribArray(acol);gl.vertexAttribPointer(acol,3,gl.FLOAT,false,24,12)}\nfunction draw(){if(!gl)return;let r=canvas.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(r.width*d);canvas.height=Math.round(r.height*d);gl.viewport(0,0,canvas.width,canvas.height);gl.clearColor(.914,.914,.875,1);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);let scale=Math.min(r.width/11.8,r.height/8.7)*zoom;gl.uniform1f(uyaw,yaw);gl.uniform1f(upitch,pitch);gl.uniform2f(uscale,2*scale/r.width,2*scale/r.height);gl.uniform3f(ucenter,.8,0,3.15);gl.uniform1i(upoints,0);gl.enable(gl.POLYGON_OFFSET_FILL);gl.polygonOffset(1,1);bind(surface);gl.drawArrays(gl.TRIANGLES,0,triCount);gl.disable(gl.POLYGON_OFFSET_FILL);if(document.querySelector('#edges').checked){bind(linebuffer);gl.drawArrays(gl.LINES,0,lineCount)}gl.uniform1i(upoints,1);bind(pointbuffer);gl.drawArrays(gl.POINTS,0,pointCount)}\nfunction updateInfo(){const m=MODELS[shape],ps=currentPieces(),part=document.querySelector('#part').value;document.querySelector('#solidCount').textContent=m.pieces.length+' solids';document.querySelector('#description').textContent=descriptions[shape];document.querySelector('#shapeBadge').textContent=names[shape];document.querySelector('#obj').href='elephant-'+shape+'-sided.obj';document.querySelector('#partInfo').textContent=part==='all'?'Entire elephant · 12 body parts · '+ps.length+' sections':part+' · '+ps.length+' sections · '+ps.map(p=>p.term).join(' : ');document.querySelector('#pieceTable').innerHTML='<table><tr><th>Section</th><th>Length</th><th>Start W × H</th><th>End W × H</th></tr>'+ps.map(p=>'<tr><td>'+p.name+'</td><td>'+p.length.toFixed(3)+'</td><td>'+p.start.map(v=>v.toFixed(2)).join(' × ')+'</td><td>'+p.end.map(v=>v.toFixed(2)).join(' × ')+'</td></tr>').join('')+'</table>';rebuild()}\nfor(const s of MODELS[shape].schedule){let o=document.createElement('option');o.value=s.part;o.textContent=s.part;document.querySelector('#part').append(o)}document.querySelector('#schedule').innerHTML=MODELS[shape].schedule.map(s=>'<tr><td>'+s.part+'</td><td>'+s.terms.join(', ')+'</td><td>'+s.lengths.map(x=>x.toFixed(3)).join(', ')+'</td><td>'+s.lengths.reduce((a,b)=>a+b,0).toFixed(2)+' cm</td></tr>').join('');\ndocument.querySelector('#shape').onchange=e=>{shape=e.target.value;updateInfo()};document.querySelector('#part').onchange=updateInfo;document.querySelector('#edges').onchange=draw;document.querySelector('#explode').oninput=e=>{document.querySelector('#explosionLabel').textContent=e.target.value+'%';rebuild()};document.querySelector('#toggleDetails').onclick=()=>document.querySelector('#pieceTable').classList.toggle('hidden');\nfunction camera(id,y,p){document.querySelectorAll('.camera button').forEach(b=>b.classList.toggle('active',b.id===id));yaw=y;pitch=p;draw()}\nfunction changeZoom(factor){zoom=Math.max(.5,Math.min(2.5,zoom*factor));draw()}document.querySelector('#zoom-out').onclick=()=>changeZoom(1/1.25);document.querySelector('#zoom-in').onclick=()=>changeZoom(1.25);document.querySelector('#perspective').onclick=()=>camera('perspective',2.42,.20);document.querySelector('#side').onclick=()=>camera('side',Math.PI,0);document.querySelector('#front').onclick=()=>camera('front',Math.PI/2,0);document.querySelector('#top').onclick=()=>camera('top',Math.PI,Math.PI/2);document.querySelector('#reset').onclick=()=>{zoom=1;document.querySelector('#explode').value=0;document.querySelector('#explosionLabel').textContent='0%';document.querySelector('#part').value='all';camera('perspective',2.42,.2);updateInfo()};canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];canvas.setPointerCapture(e.pointerId)};canvas.onpointermove=e=>{if(!drag)return;yaw+=(e.clientX-drag[0])*.008;pitch=Math.max(-1.45,Math.min(1.45,pitch+(e.clientY-drag[1])*.008));drag=[e.clientX,e.clientY];draw()};canvas.onpointerup=canvas.onpointercancel=()=>drag=null;canvas.addEventListener('wheel',e=>{e.preventDefault();changeZoom(Math.exp(-e.deltaY*.001))},{passive:false});window.onresize=draw;updateInfo();\n</script></html>\n"
